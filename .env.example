# ============================================================================
# MOF PSDG AI Chatbot — Environment Configuration
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าตามความเหมาะสม
# ห้ามนำไฟล์ .env ขึ้น Git repository โดยเด็ดขาด
# ============================================================================

# Application
APP_NAME=MOF PSDG AI Chatbot
APP_VERSION=1.0.0
DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-string

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000

# Database (SQLite สำหรับระบบ locaux, PostgreSQL สำหรับ production)
DATABASE_URL=sqlite:///./data/app.db

# AI Provider (เลือกผู้ให้บริการหนึ่งราย)
# ค่าที่รองรับ: openai, anthropic, ollama, demo
AI_PROVIDER=demo

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Ollama (สำหรับรันโมเดลในเครื่อง)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Vector Search (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=mof_psdg_knowledge

# Document Processing
MAX_FILE_SIZE_MB=16
ALLOWED_FILE_TYPES=pdf,docx,doc,xlsx,csv,txt,md,html
UPLOAD_DIRECTORY=./uploads

# Security
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Trial Link
TRIAL_LINK_DEFAULT_EXPIRY_DAYS=7
TRIAL_LINK_MAX_USAGES=100

# Classification
DOCUMENT_CLASSIFICATION_PUBLIC=PUBLIC
DOCUMENT_CLASSIFICATION_INTERNAL=INTERNAL